<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Projeto academico: usa apenas o feed público nuget.org.
    O <clear /> descarta fontes herdadas de configs de nível superior
    (ex.: o Artifactory corporativo, inacessível fora da rede da Softplan)
    e mantém uma única origem, compatível com o Central Package Management.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
